#
# Lipid double layer with water over and below
#

tolerance 2.0 
filetype pdb
output bilayer.pdb


structure water.pdb
  number 500
  inside box -15. 0. 0. 0. 45. 45.
end structure

structure water.pdb
  number 500
  inside box 40. 0. 0. 55. 45. 45.
end structure

structure palmitoil.pdb
  number 50
  inside box 0. 0. 0. 20. 45. 45.
  constrain_rotation y 0.   20.
  constrain_rotation z 180. 20.
end structure

structure palmitoil.pdb
  number 50
  inside box 14. 0. 0. 40. 45. 45.
  constrain_rotation y 180. 20.
  constrain_rotation z 180. 20.
end structure


