#
# Lipid double layer with water over and below
#

tolerance 2.0 
filetype pdb
output bilayer.pdb

structure water.pdb
  number 500
  inside box -15. 0. 0. 0. 60. 60.
end structure

structure water.pdb
  number 500
  inside box 42. 0. 0. 57. 60. 60.
end structure

structure palmitoil.pdb
  number 51
  inside box 0. 0. 0. 21. 60. 60.
  constrain_rotation y 0.   20.
  constrain_rotation z 180. 20.
end structure

structure palmitoil.pdb
  number 50
  inside box 21. 0. 0. 42. 60. 60.
  constrain_rotation y 180. 20.
  constrain_rotation z 180. 20.
end structure
