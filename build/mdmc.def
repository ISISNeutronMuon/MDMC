# Bootstrap from Docker Ubuntu Eoan image
Bootstrap: docker
From: ubuntu:19.10

# version 19.10 has to be used instead of 18.04
# This is because 18.04 is restricted to Open MPI 2.0.2, which has a bug
# which stops mpi4py bcast in some cases.

%post
    # Clang is required because gcc 9 has a bug with OpenMP support
    # See LAMMPS issue 1326 for details
    export CC=/usr/bin/clang
    export CXX=/usr/bin/clang++

    apt-get update && apt-get install -y \
      libopenmpi-dev \
      libopenmpi3 \
      python3  \
      python3-pip \
      python3-dev \
      python3-tk \
      libpsl5 \
      libhdf5-dev  \
      libnetcdf-dev \
      bash \
      git \
      liblocale-gettext-perl \
      clang \
      gfortran \
      libblas-dev \
      liblapack-dev \
      libfreetype6-dev \
      wget \
      cmake

    # Get most recent stable LAMMPS version
    wget https://lammps.sandia.gov/tars/lammps-stable.tar.gz
    mkdir /lammps \
      && tar xvzf lammps-stable.tar.gz -C /lammps --strip-components=1
    rm /lammps-stable.tar.gz

  	pip3 install --upgrade pip
  	pip3 install setuptools --upgrade

    # Build LAMMPS as a shared library, with exceptions, and with Python
  	mkdir /lammps/build
  	cd /lammps/build
  	cmake -C ../cmake/presets/all_on.cmake \
          -C ../cmake/presets/nolib.cmake \
          -D BUILD_LIB=on \
          -D BUILD_SHARED_LIBS=on \
          -D BUILD_MPI=on \
          -D LAMMPS_EXCEPTIONS=on \
          -D DOWNLOAD_VORO=on \
          -D PKG_PYTHON=on \
          -D PKG_VORONOI=on \
          ../cmake
    make
    # make install-python installs liblammps.so in incorrect location
    # So install LAMMPS Python module manually
    cd /lammps/python
    python3 install.py -m lammps.py \
                       -l ../build/liblammps.so \
                       -v ../src/version.h \
                       -d /usr/local/lib/python3.7/dist-packages/
